# =============================================================================
# Template for ~/.hermes/.env
# =============================================================================
# The real .env is gitignored (see .gitignore). Copy this file to `.env`
# and fill in the values. Never commit the populated .env.
#
#   cp ~/.hermes/.env.example ~/.hermes/.env
#   chmod 600 ~/.hermes/.env
#
# Inside the container this file is /opt/data/.env. `hermes config set` routes
# every UPPER_SNAKE_CASE key here automatically (e.g. `hermes config set
# STRATA_API_KEY <value>`), so you can populate it that way instead of editing.
# =============================================================================

# Online DeepSeek API. Get a key at https://platform.deepseek.com
# Used by: model.provider=deepseek, and the `ds` model alias.
DEEPSEEK_API_KEY=

# Key for the gateway's OpenAI-compatible API server on 127.0.0.1:8642.
# Auto-generated by the container on first boot; rotate by clearing it and
# restarting. Clients send it as: Authorization: Bearer <value>
API_SERVER_KEY=

# Shared secret for the LOCAL Strata server (Qwen3.8-Flash-Next on the V100,
# 0.0.0.0:8080). Required because Strata is bound beyond loopback, so LAN and
# Tailscale peers can reach it. Referenced by:
#   providers.strata.key_env  and  model_aliases.strata.key_env
# Must match the api_key configured on the Strata side (strata-128k.json).
STRATA_API_KEY=
